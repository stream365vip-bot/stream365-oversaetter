# Kopiér denne fil til /opt/oversaetter/.env og udfyld de tomme felter.
# Linjer der starter med # er forklaringer og bliver ignoreret.

# --- SKAL udfyldes ---------------------------------------------------------------

# Bazarr: API-nøglen står i Bazarr under Settings > General > Security > API Key
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=

# Radarr: Settings > General > API Key
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Sonarr: Settings > General > API Key
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Seerr: adressen på Docker-netværket (typisk http://seerr:5055 eller http://overseerr:5055)
# og API-nøglen fra Seerr under Settings > General > API Key
SEERR_URL=
SEERR_API_KEY=

# --- Sikkerhed og udgifter -------------------------------------------------------

# true = prøvetilstand: programmet logger kun hvad det VILLE gøre. Ingen oversættelse, ingen filer.
# Sæt til false når loggen ser rigtig ud.
DRY_RUN=true

# Højeste beløb i dollars pr. kalendermåned (UTC) til programmets egne kald til Claude.
# TRANSLATE_MODE=direct: hele oversættelsen betales herfra (ca. 1,30 USD pr. lang film med Opus). Når loftet er nået,
# startes der ingen nye oversættelser, før næste måned (eller et højere loft).
# TRANSLATE_MODE=lingarr: kun korrekturen betales herfra. Når loftet er nået, gemmes Haikus oversættelse uden korrektur.
MONTHLY_BUDGET_USD=5

# --- Oversættelse ----------------------------------------------------------------

# direct = programmet oversætter selv med Claude i bidder af 50 og afleverer filen til Bazarr (standard).
# lingarr = det gamle flow: Bazarr oversætter med Lingarr/Haiku, og programmet laver korrektur bagefter.
TRANSLATE_MODE=direct

# Model og grundighed (low, medium eller high) til oversættelsen og rettelsesrunden (kun direct).
# Valgt efter test 18.10.2026: Opus med medium (se README under "Beslutninger").
TRANSLATE_MODEL=claude-opus-5-5
TRANSLATE_EFFORT=medium

# Afviser modellen en bid (refusal) også efter halvering, prøves bidden med denne model (kun direct).
FALLBACK_MODEL=claude-sonnet-5-5

# Højst så mange replikker, som den gratis kontrol har flaget, sendes i rettelsesrunden (kun direct).
MAX_FIX_LINES=60

# Forbedringer fra 18.10.2026 (kun direct). Slået til efter test14/test15 på Do Not Enter (ca. 9/10, se README).
# PROMPT_VERSION=v4 (skarpere instruks + skarpere kontrol, fyldlyde fjernes) eller v3 (den gamle instruks).
PROMPT_VERSION=v4
# CONTEXT=on: titel, år, genre, handling og rolleliste fra Radarr/Sonarr (og TMDB, hvis nøglen findes) i instruksen.
CONTEXT=on
# GLOSSARY=on: ét ekstra kald før bidderne laver en ordliste med navne, udtryk og du/De (genbruges i serier).
GLOSSARY=on
# Så mange bidder sendes samtidig (1 = én ad gangen).
PARALLEL=4
# Læsehastighed i tegn pr. sekund, før en replik får informationsflaget reading_speed (tælles kun, rettes aldrig).
READING_SPEED_MAX=25
# true = systeminstruksen (instruks, filmkontekst, ordliste) caches hos Anthropic mellem bidderne. Billigere input.
PROMPT_CACHE=true
# true = har en linje ♪ eller # i starten eller slutningen, fjernes hele replikken fra den engelske kilde
# (sangtekst oversættes ikke).
DROP_LYRICS=true

# --- Kan stå som de er -----------------------------------------------------------

# Hvor ofte programmet kigger efter nyt (minutter)
POLL_MINUTES=15

# Film med dette mærke (tag) i Radarr og serier med det i Sonarr bliver også oversat (ligesom Seerr-ønsker).
# Der oversættes kun, når en gyldig søgning i Bazarr ikke har fundet dansk (se README).
TRANSLATE_TAG=oversaet

# Hvor længe der højst ventes på Bazarrs søgning efter dansk i én runde (minutter)
SEARCH_TIMEOUT_MINUTES=10

# Højst så mange nye søgninger pr. runde
MAX_SEARCHES_PER_ROUND=10

# Hvor længe der højst ventes på Bazarrs oversættelse (lingarr), eller hvor længe programmets egen oversættelse
# af ét emne højst må tage i alt (direct) - i minutter
TRANSLATE_TIMEOUT_MINUTES=45

# --- Kun TRANSLATE_MODE=lingarr (ignoreres i direct) ------------------------------

# Hvor længe der højst ventes på ét svar fra korrekturmodellen (minutter). Ellers springes bidden over.
PROOFREAD_CALL_TIMEOUT_MINUTES=10

# Hvor længe efterbehandlingen af ét emne højst må tage i alt (minutter). Derefter gemmes filen
# med de rettelser, der er nået, og kreditlinjen sættes ind.
POSTPROCESS_TIMEOUT_MINUTES=30

# Hvor mange replikker korrekturmodellen får ad gangen
PROOFREAD_BATCH=50

# Model og grundighed for korrekturen (low, medium eller high). Højere = grundigere men dyrere.
# Valgt efter test: Opus med medium (se README under "Beslutninger").
PROOFREAD_MODEL=claude-opus-5-5
PROOFREAD_EFFORT=medium

# Pris pr. million tokens i dollars for korrekturmodellen (ret dem, hvis du skifter model).
# I direct-tilstand bruges priserne i MODEL_PRICES i oversaetter/config.py; disse bruges kun for en ukendt model.
PRICE_INPUT_PER_M=4
PRICE_OUTPUT_PER_M=20

# --- Fælles --------------------------------------------------------------------------

# Længste tilladte linje i en undertekst (tegn)
MAX_LINE_CHARS=42

# Ekstra ord, der altid er forkerte i en dansk undertekst (kommasepareret, hele ord, store/små bogstaver er ligegyldige).
# Lægges oven i den indbyggede liste: bestie, bestien, menneskebestie, menneskebestien, uansett, please,
# sweetheart, prank, llige, here. Replikker med ordene sendes til rettelse/korrektur.
KNOWN_BAD_WORDS=

# Teksten der vises i starten af hver oversat fil (lad den være tom for ingen kreditlinje).
# \n (backslash + n) giver et linjeskift. Behold de enkelte anførselstegn ' omkring teksten.
CREDIT_TEXT='Oversat til dig af\n<font color="#58D9AE">≋ </font><b>Stream<font color="#58D9AE">365</font></b>'

# Filen med Anthropic-nøglen (samme fil som Lingarr bruger, monteret ind via compose.yaml)
ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# Nøglefiler til testtilstanden oversaet-test (DeepSeek og Gemini). Bruges ikke af driften.
# Filerne ligger på serveren i /opt/oversaetter/secrets/ og monteres ind via compose.yaml.
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Valgfri TMDB-nøgle til filmkonteksten (CONTEXT=on): dansk handling og rolleliste med køn.
# Filen ligger på serveren i /opt/oversaetter/secrets/tmdb_api_key.txt. Alternativt TMDB_API_KEY=<nøgle>.
TMDB_API_KEY_FILE=/run/secrets/tmdb_api_key

# Hvor databasen gemmes inde i containeren
DATA_DIR=/data

# INFO (normal) eller DEBUG (meget snakkesalig)
LOG_LEVEL=INFO
